---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ReadingCalendar from '../components/ReadingCalendar.astro';
import ReadingItem from '../components/ReadingItem.astro';
import {withBase} from '../lib/docs';
import {kinds, monthLabel, reading, readingDays, type ReadingEntry} from '../lib/reading';

const months = new Map<string, ReadingEntry[]>();

for (const item of reading) {
  const month = item.date.slice(0, 7);
  months.set(month, [...(months.get(month) ?? []), item]);
}

/** Every month from the first link to the last, newest first, so a quiet month still shows up empty. */
function monthRange(newest: string, oldest: string) {
  const range = [];
  const cursor = new Date(`${newest}-01T12:00:00Z`);

  while (cursor.toISOString().slice(0, 7) >= oldest) {
    range.push(cursor.toISOString().slice(0, 7));
    cursor.setUTCMonth(cursor.getUTCMonth() - 1);
  }

  return range;
}

const calendarMonths = readingDays.length ? monthRange(readingDays[0].date.slice(0, 7), readingDays.at(-1)!.date.slice(0, 7)) : [];
---

<Base title="Reading" description="Articles, posts, repos and tools I am reading and recommend, newest first.">
  <PageHead
    title="Reading"
    note={`${reading.length} links`}
    lede="What I am reading and what I would hand to you: articles, posts, repos and tools, newest first. Each one is something I shared with my team because it was worth the time. Pick a day on the calendar to see what I was reading then."
  >
    <nav class="links" aria-label="Follow">
      <a href={withBase('/reading.xml')}>RSS feed</a>
    </nav>
  </PageHead>

  <section class="row reading-calendar" aria-labelledby="calendar-title">
    <div class="margin reading-margin">
      <p>{readingDays.length} days</p>
      <p>Pick a day to see what I was reading.</p>
    </div>
    <div class="body">
      <h2 id="calendar-title" class="sub-title">Calendar</h2>
      <ReadingCalendar months={calendarMonths} />
    </div>
  </section>

  <div class="row reading" data-reading>
    <div class="margin reading-margin">
      <p class="reading-count" aria-live="polite"><span data-count>{reading.length}</span> shown</p>
    </div>
    <div class="body">
      <div class="reading-controls">
        <div class="tabs" role="group" aria-label="Kind">
          <button type="button" class="tab" data-kind-button="" aria-pressed="true">All</button>
          {
            kinds.map((kind) => (
              <button type="button" class="tab" data-kind-button={kind.id} aria-pressed="false">
                {kind.label}
              </button>
            ))
          }
        </div>
        <label class="reading-field">
          <span>Search</span>
          <input type="search" data-filter-text placeholder="Filter by title, site or note" autocomplete="off" />
        </label>
      </div>

      <p class="reading-empty" data-empty hidden>Nothing matches. Clear the search or pick another kind.</p>

      {
        [...months].map(([month, items]) => (
          <section class="reading-month" data-month>
            <h2 class="reading-month-title">{monthLabel(month)}</h2>
            <ol class="reading-list" role="list">
              {items.map((item) => (
                <ReadingItem item={item} />
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </div>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-reading]');

  if (root) {
    const items = [...root.querySelectorAll<HTMLElement>('[data-item]')];
    const months = [...root.querySelectorAll<HTMLElement>('[data-month]')];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-kind-button]')];
    const text = root.querySelector<HTMLInputElement>('[data-filter-text]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    let kind = '';

    const apply = () => {
      const query = text.value.trim().toLowerCase();
      let shown = 0;

      for (const item of items) {
        const visible = (!kind || item.dataset.kind === kind) && (!query || item.dataset.search!.includes(query));
        item.hidden = !visible;
        shown += visible ? 1 : 0;
      }

      for (const month of months) {
        month.hidden = !month.querySelector('[data-item]:not([hidden])');
      }

      count.textContent = String(shown);
      empty.hidden = shown > 0;
    };

    for (const button of buttons) {
      button.addEventListener('click', () => {
        kind = button.dataset.kindButton ?? '';
        buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
        apply();
      });
    }

    text.addEventListener('input', apply);
  }
</script>

<style>
  .reading-margin {
    padding-top: 12px;
  }

  .reading-count {
    margin: 0;
  }

  .reading-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 8px;
  }

  .reading-field {
    display: flex;
    flex: 1 1 260px;
    max-width: 420px;
    flex-direction: column;
    gap: 4px;
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--pencil);
  }

  .reading-field input {
    min-height: 44px;
    padding: 0 12px;
    border: 1.5px solid var(--rule-strong);
    border-radius: 6px;
    background: var(--card);
    color: var(--ink);
    font: inherit;
    font-size: 16px;
    font-weight: 400;
  }

  .reading-field input:focus {
    outline: none;
    border-color: var(--blue);
  }

  .reading-empty {
    margin: 32px 0 0;
    font-family: var(--sans);
    color: var(--pencil);
  }

  .reading-month {
    padding-top: 40px;
  }

  .reading-month-title {
    margin: 0;
    padding-bottom: 8px;
    border-bottom: 1.5px solid var(--rule-strong);
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--pencil);
  }

  .reading-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reading-calendar {
    padding-bottom: 24px;
  }
</style>
