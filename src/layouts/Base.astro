---
import '../styles/global.css';

import Search from '../components/Search.astro';
import {routeKey} from '../lib/cards';
import {withBase} from '../lib/docs';
import {person} from '../data/site';

type Props = {
  title?: string;
  description?: string;
  /** Notes are articles; they also share their tags and last update. */
  article?: {tags: string[]; updated: string | null};
};

const {title, description = person.intro, article} = Astro.props;
const fullTitle = title ? `${title} | ${person.name}` : `${person.name}, ${person.role} at ${person.company.name}`;
const route = routeKey(Astro.url.pathname, import.meta.env.BASE_URL);
const canonical = new URL(withBase(route === 'index' ? '/' : `/${route}`), Astro.site);
const image = new URL(withBase(`/og/${route}.png`), Astro.site);

const nav = [
  {label: 'What I do', url: withBase('/#skills')},
  {label: 'Writing', url: withBase('/#writing')},
  {label: 'Visualized', url: withBase('/#visualized')},
  {label: 'Code', url: withBase('/#code')},
  {label: 'Notes', url: withBase('/category/notes')},
  {label: 'Graph', url: withBase('/graph')},
  {label: 'Work with me', url: withBase('/#work')},
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title ?? person.name}, on ${person.name}'s site`} />
    {article?.updated && <meta property="article:modified_time" content={article.updated} />}
    {article && <meta property="article:author" content={person.name} />}
    {article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={person.x.handle} />
    <meta name="twitter:creator" content={person.x.handle} />
    <meta name="twitter:title" content={title ?? fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="author" content={person.name} />
    <meta name="theme-color" content="#edf0f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131920" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/icons/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Schibsted+Grotesk:wght@400;500;600;700;800&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="page">
      <nav class="row nav" aria-label="Main">
        <div class="margin nav-name">
          <a class="plain" href={withBase('/')}>{person.name}</a>
        </div>
        <div class="body nav-body">
          <ul class="nav-links" role="list">
            {
              nav.map((item) => (
                <li>
                  <a class="plain" href={item.url}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <button class="search-open" type="button" data-search-open aria-haspopup="dialog">
            <span>Search notes</span>
            <kbd>⌘K</kbd>
          </button>
        </div>
      </nav>

      <main id="main">
        <slot />
      </main>

      <footer class="row footer">
        <div class="margin"></div>
        <div class="body">
          <p>
            The notes are open source. <a href="https://github.com/sibelius/zettelkasten">Edit any of them on GitHub</a>,
            or support the writing on <a href="https://www.patreon.com/sibelius">Patreon</a> or{' '}
            <a href="https://github.com/sponsors/sibelius">GitHub Sponsors</a>.
          </p>
          <p>
            <a href={person.x.url}>X</a>, <a href={person.github.url}>GitHub</a>,{' '}
            <a href="https://sibelius.substack.com/">Substack</a>, <a href="https://dev.to/sibelius">dev.to</a>,{' '}
            <a href="https://sibelius.medium.com/">Medium</a>, <a href="https://speakerdeck.com/sibelius">SpeakerDeck</a>.
            Copyright {person.name}.
          </p>
        </div>
      </footer>
    </div>

    <Search />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: -80px;
    padding: 10px 14px;
    background: var(--ink);
    color: var(--on-ink);
    font-family: var(--sans);
    z-index: 10;
  }

  .skip:focus {
    top: 16px;
  }

  .nav {
    padding: 22px 0;
    align-items: center;
  }

  .nav-name {
    font-weight: 800;
    font-size: 18px;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .nav-body {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px 24px;
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 500;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-links a {
    display: inline-block;
    padding: 10px 0;
  }

  .search-open {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-width: 220px;
    min-height: 44px;
    padding: 0 14px;
    font: inherit;
    font-size: 15px;
    color: var(--pencil);
    background: var(--card);
    border: 1.5px solid var(--rule-strong);
    border-radius: 6px;
    cursor: pointer;
  }

  .search-open:hover {
    border-color: var(--ink);
  }

  .search-open kbd {
    font-family: inherit;
    font-weight: 600;
    color: var(--ink);
  }

  .footer {
    padding: 112px 0 48px;
  }

  .footer .body {
    font-family: var(--sans);
    font-size: 15px;
    color: var(--pencil);
  }

  .footer p {
    margin: 0 0 6px;
  }

  @media (max-width: 760px) {
    .search-open {
      width: 100%;
    }
  }
</style>
