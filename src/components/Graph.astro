---
import type {GraphData} from '../lib/graph';

type Props = {
  data: GraphData;
  height?: string;
  id?: string;
};

const {data, height = '560px', id = 'graph'} = Astro.props;
---

<div class="graph" data-graph>
  <script is:inline type="application/json" data-graph-data set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />

  <div class="graph-toolbar">
    <div class="graph-search">
      <label class="graph-search-label" for={`${id}-search`}>Find a note in the graph</label>
      <input
        id={`${id}-search`}
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="Find a note or tag"
        role="combobox"
        aria-expanded="false"
        aria-controls={`${id}-results`}
        aria-autocomplete="list"
      />
      <ul id={`${id}-results`} class="graph-results" role="listbox" aria-label="Matching notes" hidden></ul>
    </div>
    <div class="graph-zoom" role="group" aria-label="Zoom">
      <button type="button" data-zoom="out" aria-label="Zoom out">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10h10" /></svg>
      </button>
      <button type="button" data-zoom="in" aria-label="Zoom in">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10h10M10 5v10" /></svg>
      </button>
      <button type="button" data-zoom="fit" class="graph-fit">Fit</button>
    </div>
  </div>

  <div class="graph-stage" style={`height: ${height}`}>
    <svg class="graph-svg" role="img" aria-label="Graph of notes, the tags they carry and the links between them"></svg>
    <aside class="graph-panel" aria-label="Preview" aria-live="polite" hidden></aside>
  </div>

  <p class="graph-caption" aria-live="polite"></p>
</div>

<script>
  import {initGraph} from '../scripts/graph';

  document.querySelectorAll<HTMLElement>('[data-graph]').forEach(initGraph);
</script>

<style is:global>
  .graph {
    position: relative;
    font-family: var(--sans);
  }

  .graph-toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
  }

  .graph-search {
    position: relative;
    flex: 1 1 280px;
    max-width: 420px;
  }

  .graph-search-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .graph-search input {
    width: 100%;
    min-height: 44px;
    padding: 0 14px;
    border: 1.5px solid var(--rule-strong);
    border-radius: 6px;
    background: var(--card);
    color: var(--ink);
    font: inherit;
    font-size: 16px;
  }

  .graph-search input:focus {
    outline: none;
    border-color: var(--blue);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--blue) 25%, transparent);
  }

  .graph-results {
    position: absolute;
    z-index: 5;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    margin: 0;
    padding: 6px;
    list-style: none;
    background: var(--paper);
    border: 1.5px solid var(--ink);
    border-radius: 8px;
    box-shadow: 0 18px 40px -18px rgb(8 12 20 / 0.45);
  }

  .graph-results li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 6px;
    cursor: pointer;
  }

  .graph-results li[aria-selected='true'],
  .graph-results li:hover {
    background: var(--ink);
    color: var(--on-ink);
  }

  .graph-results mark {
    background: none;
    color: inherit;
    text-decoration: underline 2px var(--blue);
    text-underline-offset: 3px;
  }

  .graph-hit-title {
    font-weight: 600;
  }

  .graph-hit-meta {
    font-size: 13px;
    opacity: 0.75;
    align-self: center;
  }

  .graph-zoom {
    display: flex;
    gap: 6px;
  }

  .graph-zoom button {
    display: grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 12px;
    border: 1.5px solid var(--rule-strong);
    border-radius: 6px;
    background: var(--card);
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .graph-zoom button:hover {
    border-color: var(--ink);
  }

  .graph-zoom svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .graph-stage {
    position: relative;
    overflow: hidden;
    border: 1.5px solid var(--rule-strong);
    border-radius: 10px;
    background-color: var(--card);
    background-image: repeating-linear-gradient(to bottom, transparent 0, transparent 31px, var(--ruled) 31px, var(--ruled) 32px);
  }

  .graph-svg {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .graph-svg.is-dragging {
    cursor: grabbing;
  }

  .graph-viewport {
    opacity: 0;
    transition: opacity 500ms ease;
  }

  .graph.is-ready .graph-viewport {
    opacity: 1;
  }

  .graph-link {
    stroke: var(--edge);
    stroke-width: calc(1px / var(--k, 1));
    opacity: 0.45;
    transition: opacity 200ms ease, stroke 200ms ease;
  }

  .graph-link-link {
    stroke: var(--ink);
    opacity: 0.55;
    stroke-width: calc(1.3px / var(--k, 1));
  }

  .graph-node {
    cursor: pointer;
    transition: opacity 200ms ease, fill 200ms ease;
  }

  .graph-node-note {
    fill: var(--ink);
  }

  .graph-node-tag {
    fill: var(--card);
    stroke: var(--ink);
    stroke-width: calc(1.6px / var(--k, 1));
  }

  .graph-node:hover,
  .graph-node.is-lit {
    fill: var(--blue);
  }

  .graph-node-tag.is-lit {
    stroke: var(--blue);
  }

  .graph-node.is-selected {
    fill: var(--red);
    stroke: var(--red);
  }

  .graph-label {
    fill: var(--ink);
    font-family: var(--sans);
    text-anchor: middle;
    paint-order: stroke;
    stroke: var(--card);
    stroke-linejoin: round;
    pointer-events: none;
    transition: opacity 200ms ease;
  }

  .graph-label-tag {
    font-size: calc(14px / var(--k, 1));
    font-weight: 700;
    stroke-width: calc(4px / var(--k, 1));
  }

  .graph-label-note {
    font-size: calc(12px / var(--k, 1));
    font-weight: 500;
    stroke-width: calc(3px / var(--k, 1));
    opacity: 0;
  }

  .graph-svg.is-zoomed .graph-label-note,
  .graph-label-note.is-lit {
    opacity: 1;
  }

  .graph-svg.has-focus .graph-node:not(.is-lit),
  .graph-svg.has-focus .graph-label-tag:not(.is-lit) {
    opacity: 0.12;
  }

  .graph-svg.has-focus .graph-label-note:not(.is-lit) {
    opacity: 0;
  }

  .graph-svg.has-focus .graph-link {
    opacity: 0.06;
  }

  .graph-svg.has-focus .graph-link.is-lit {
    opacity: 0.9;
    stroke: var(--blue);
  }

  .graph-panel {
    position: absolute;
    top: 12px;
    right: 12px;
    bottom: 12px;
    width: min(340px, calc(100% - 24px));
    overflow-y: auto;
    padding: 18px 20px 20px;
    background: var(--paper);
    border: 1.5px solid var(--ink);
    border-radius: 8px;
    box-shadow: 0 18px 40px -18px rgb(8 12 20 / 0.45);
  }

  .graph-panel.is-entering {
    animation: panel-in 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateX(16px);
    }
  }

  .graph-panel-close {
    float: right;
    min-height: 32px;
    padding: 0 10px;
    border: 1.5px solid var(--rule-strong);
    border-radius: 6px;
    background: var(--card);
    color: var(--pencil);
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }

  .graph-panel-kind {
    margin: 4px 0 6px;
    font-size: 14px;
    color: var(--pencil);
  }

  .graph-panel-title {
    margin: 0 0 10px;
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .graph-panel-text {
    margin: 0 0 16px;
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .graph-panel-open {
    margin-bottom: 6px;
  }

  .graph-panel-sub {
    margin: 22px 0 6px;
    padding-bottom: 6px;
    border-bottom: 2px solid var(--ink);
    font-size: 15px;
  }

  .graph-panel-list,
  .graph-panel-chips {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .graph-panel-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-top: 6px;
  }

  .graph-jump {
    width: 100%;
    min-height: 40px;
    padding: 8px 0;
    border: 0;
    border-bottom: 1px solid var(--rule);
    background: none;
    color: var(--blue);
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
  }

  .graph-panel-chips .graph-jump {
    width: auto;
    min-height: 36px;
    padding: 4px 12px;
    border: 1.5px solid var(--rule-strong);
    border-radius: 6px;
  }

  .graph-jump:hover {
    color: var(--blue-deep);
  }

  .graph-caption {
    margin: 10px 2px 0;
    font-size: 15px;
    color: var(--pencil);
  }

  @media (max-width: 720px) {
    .graph-panel {
      top: auto;
      left: 8px;
      right: 8px;
      bottom: 8px;
      width: auto;
      max-height: 60%;
    }

    @keyframes panel-in {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
    }
  }
</style>
