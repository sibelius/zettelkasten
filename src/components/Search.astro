---
import {withBase} from '../lib/docs';
---

<dialog class="search" data-search data-index={withBase('/search.json')} aria-label="Search notes">
  <form method="dialog" class="search-form" role="search">
    <label class="search-label" for="search-input">Search notes</label>
    <input
      id="search-input"
      class="search-input"
      type="search"
      autocomplete="off"
      spellcheck="false"
      placeholder="Try relay, career or writing"
      aria-controls="search-results"
      aria-autocomplete="list"
    />
    <button class="search-close" type="submit" aria-label="Close search">Esc</button>
  </form>
  <ul id="search-results" class="search-results" role="listbox" aria-label="Results"></ul>
  <p class="search-status" aria-live="polite"></p>
</dialog>

<script>
  import {initSearch} from '../scripts/search';

  initSearch();
</script>

<style is:global>
  .search {
    width: min(680px, calc(100vw - 32px));
    max-height: min(640px, calc(100vh - 96px));
    margin: 12vh auto auto;
    padding: 0;
    border: 1.5px solid var(--ink);
    border-radius: 10px;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 24px 60px -20px rgb(8 12 20 / 0.45);
    overflow: hidden;
  }

  .search[open] {
    display: flex;
    flex-direction: column;
    animation: search-in 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .search::backdrop {
    background: rgb(12 16 24 / 0.35);
    backdrop-filter: blur(2px);
  }

  @keyframes search-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }

  .search-form {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-bottom: 2px solid var(--ink);
  }

  .search-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .search-input {
    flex: 1;
    min-height: 48px;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 20px;
    outline: none;
  }

  .search-input::placeholder {
    color: var(--pencil);
  }

  .search-close {
    min-height: 36px;
    padding: 0 10px;
    border: 1.5px solid var(--rule-strong);
    border-radius: 6px;
    background: var(--card);
    color: var(--pencil);
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }

  .search-results {
    margin: 0;
    padding: 6px;
    list-style: none;
    overflow-y: auto;
  }

  .search-results a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2px 16px;
    padding: 12px 14px;
    border-radius: 6px;
    color: var(--ink);
    text-decoration: none;
  }

  .search-results [aria-selected='true'] a {
    background: var(--ink);
    color: var(--on-ink);
  }

  .search-results [aria-selected='true'] .search-meta,
  .search-results [aria-selected='true'] .search-excerpt {
    color: var(--on-ink);
    opacity: 0.8;
  }

  .search-title {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 17px;
  }

  .search-meta {
    font-family: var(--sans);
    font-size: 13px;
    color: var(--pencil);
    align-self: center;
  }

  .search-excerpt {
    grid-column: 1 / -1;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .search-results mark {
    background: none;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--blue);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .search-status {
    margin: 0;
    padding: 10px 20px 14px;
    font-family: var(--sans);
    font-size: 14px;
    color: var(--pencil);
  }

  .search-status:empty {
    display: none;
  }
</style>
