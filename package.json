{
  "name": "zettelkasten",
  "version": "0.0.0",
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/qrcode": "^1.5.6",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{md,mdx}": [
      "prettier --write"
    ],
    "*.yml": [
      "prettier --write"
    ]
  },
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "sync": "node scripts/sync-content.mjs",
    "prepare": "husky",
    "publish:docs": "pnpm build && gh-pages -d dist"
  }
}
